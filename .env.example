# The active Morrow app uses Supabase Postgres, not a local SQLite database.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Production data and identity target. Create and own the project in the
# Supabase dashboard; never expose the secret key in browser code.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# Runtime uses the pooled URL; migrations use the direct URL.
SUPABASE_DATABASE_URL=""
SUPABASE_DIRECT_URL=""
# Paste the database CA certificate from Supabase Database Settings in Production.
# The runtime uses it to verify the database server's TLS certificate.
SUPABASE_DB_CA_CERT=""

# Owner credentials are created once inside Morrow and stored as a salted
# password hash. Session tokens are generated automatically and stored hashed.

# Optional social listening. Leave blank until the official accounts are connected.
X_BEARER_TOKEN=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_ACCOUNT_ID=""
META_GRAPH_VERSION="v23.0"

# Set CRON_SECRET in Vercel Production so its scheduled requests are authenticated.
# Use a random value of at least 16 characters and keep it server-only.
MORROW_AUTOMATION_SECRET=""
CRON_SECRET=""

# External notification delivery. Secrets stay server-side and must never use
# a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=""
MORROW_EMAIL_FROM="Morrow <alerts@your-domain.com>"

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_VERIFY_SERVICE_SID=""
# Use TWILIO_FROM_NUMBER only when a Messaging Service is not configured.
TWILIO_FROM_NUMBER=""

# Generate one VAPID pair for web push and keep the private key secret.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@your-domain.com"
